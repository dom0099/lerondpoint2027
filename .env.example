# Copier en .env et renseigner. Le .env n'est jamais versionné.

ENVIRONMENT=dev

# openssl rand -hex 32
POSTGRES_PASSWORD=
SECRET_KEY=

###### SMTP ######
# Même relais Brevo que le déploiement Pol.is, mais avec sa PROPRE copie des
# identifiants : couper Pol.is ne doit pas casser l'authentification d'ici.
# L'adresse de MAIL_FROM doit être un expéditeur vérifié côté Brevo ; seul le nom
# d'affichage est libre.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Le Rond-Point 2027 <noreply@lerondpoint2027.fr>"
